# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# Local Docker: mongodb://mongo:27017/cv_builder
# MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/cv_builder
MONGO_URI=mongodb://mongo:27017/cv_builder

# JWT Secret (use strong random string for production)
# Generate with: openssl rand -base64 32
SECRET=your_jwt_secret_here

# Frontend URL (for CORS and redirects)
# Development: http://localhost:5173
# Production (Vercel): https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# Puppeteer Configuration (Render deployment)
# For Render, set these values:
# PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
